include <banded/color_definition.scad>


color_ral_effect = [ prepare_color_name( [
	[ "RAL Effect colors"
	,["ral", "ral effect", "ral_effect"]
	,[""]
	,function (name,lang)
		lang!="" ? undef :
		(  name[0]=="r"
		&& name[1]=="a"
		&& name[2]=="l"
		&&(name[3]==" " || name[3]=="_")
		// 2 numeric letter
		&& name[6]=="0"
		&& name[7]=="-"
		&& name[8]!=undef
		&& name[9]==undef)
		?
		let (
			z = 48, // ord("0")
			a = ord(name[4])-z,
			b = ord(name[5])-z,
			C = ord(name[8])-z,
			c = C==7 ? -1 :
				name[8]=="m" ? 7 :
				C
		)
		// check ral number range
		(a<1 || a>8) ? undef :
		(b<1 || b>9 || (a==8 && b>7)) ? undef :
		(c<1 || c>7) ? undef :
		// calculate index of ral number
		[0, (a-1)*9*7 + (b-1)*7 + (c-1) ]
		: undef
	],[
